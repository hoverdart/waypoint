# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ---
/frontend/node_modules
/frontend/.next/
/frontend/out/
/frontend/build
/frontend/next-env.d.ts
# Clerk's keyless-mode auto-provisioned dev credentials - local only, never commit
/frontend/.clerk/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions

# --- backend (Python/FastAPI) ---
/backend/.venv
/backend/**/__pycache__/
/backend/*.egg-info/
/backend/.pytest_cache/
/backend/.ruff_cache/

# --- testing/coverage ---
/coverage
.pytest_cache/

# --- python (generic) ---
*.pyc
*.pyo

# --- misc ---
.DS_Store
*.pem

# --- debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- env files ---
# Real env files are never committed; example templates always are.
.env*
!.env.example
!*/.env.example

# --- vercel ---
.vercel

# --- typescript ---
*.tsbuildinfo
