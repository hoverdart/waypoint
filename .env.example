# Root-level env vars used only for Docker Compose interpolation
# (e.g. `${POSTGRES_USER}` inside docker-compose.yml). Service-specific
# configuration lives in backend/.env.example and frontend/.env.example.

POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint
POSTGRES_DB=waypoint_dev
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Duplicated from frontend/.env.example: Next.js inlines NEXT_PUBLIC_* vars
# into the client JS bundle at `next build` time, so docker-compose must pass
# it as a build arg (see docker-compose.yml's frontend.build.args) - a plain
# runtime `environment:`/`env_file:` entry would be invisible to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
