# Local Postgres defaults. The optional API keys leave their features disabled.
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@localhost:5432/waypoint_dev

# Clerk is required to sign in through the frontend.
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
ADMIN_USER_IDS=[]

# Anthropic powers the optional Explain feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_FREE_WEEKLY_CAP=5
AI_PREMIUM_WEEKLY_CAP=30

JOBS_TRIGGER_SECRET=
RUN_SEED_ON_BOOT=false
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DIAGNOSTIC_QUESTION_COUNT=20
TOPIC_TIMER_MAX=30.0
