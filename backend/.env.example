# Database
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@localhost:5432/waypoint_dev

# Auth (Clerk)
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# JSON array of Clerk user IDs (auth_provider_id) allowed to use /admin/* routes
ADMIN_USER_IDS=[]

# AI (Anthropic Claude) - capped runtime "explain" feature
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_FREE_WEEKLY_CAP=5
AI_PREMIUM_WEEKLY_CAP=30

# Jobs
JOBS_TRIGGER_SECRET=
RUN_SEED_ON_BOOT=false

# App
ENVIRONMENT=development
# JSON array of allowed CORS origins
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Planner/diagnostic tuning
DIAGNOSTIC_QUESTION_COUNT=20
TOPIC_TIMER_MAX=30.0
